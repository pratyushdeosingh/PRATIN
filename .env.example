PRATIN_INTEGRATION_MODE=auto
INVOICE_RISK_URL=http://127.0.0.1:8001
CAPITAL_MARKET_URL=http://127.0.0.1:8002
PRATIN_DB_PATH=data/pratin.db
PRATIN_DATABASE_BACKEND=sqlite
# Server-only pooled/direct Postgres URL from Supabase Dashboard → Connect.
# Never expose this value to Vite or commit it.
SUPABASE_DATABASE_URL=
SERVICE_TIMEOUT_SECONDS=3
VITE_API_BASE_URL=http://127.0.0.1:8000
PRATIN_ENABLE_DIGITAL_TWIN=true
PRATIN_ENABLE_STRESS_LAB=true
